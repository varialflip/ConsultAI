# Ne jamais envoyer ces éléments au démon Docker (et donc jamais dans l'image)
.git
.gitignore
data/
secrets/
*.db
*.db-wal
*.db-shm
.env
.env.*
!.env.example
__pycache__/
*.py[cod]
.venv/
venv/
# L'étape « tailwind-builder » du Dockerfile fait son propre npm install :
# envoyer celui de l'hôte au démon Docker ne servirait qu'à alourdir le
# contexte de construction pour rien.
node_modules/
README.md
*.md
!app/**/*.md
!CHANGELOG.md
.DS_Store
@eaDir/
