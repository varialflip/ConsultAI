# =============================================================================
# ConsultAI — Configuration
# =============================================================================
# Copiez ce fichier vers .env puis adaptez les valeurs :
#     cp .env.example .env
# Le fichier .env NE DOIT JAMAIS être versionné (voir .gitignore).
# =============================================================================

# --- Identité du processus dans le conteneur ---------------------------------
# ⚠️ OBLIGATOIRE SUR SYNOLOGY. Exécutez `id votre_utilisateur` en SSH et
# recopiez uid= et gid= ici. Les dossiers partagés Synology portent des ACL
# qui refusent l'écriture aux UID inconnus, même en apparence « 777 » : avec
# une mauvaise valeur, l'application s'arrête au démarrage sur
# « sqlite3.OperationalError: unable to open database file ».
APP_UID=1000
APP_GID=1000


# --- Point d'écoute -----------------------------------------------------------
# Adresse du NAS sur laquelle le conteneur est publié. Elle doit être joignable
# par Pangolin. Une adresse de bouclage (127.0.0.1) ne l'est QUE si Pangolin
# tourne sur ce même NAS ; sinon le proxy renvoie « Bad Gateway », un hôte
# distant ne pouvant pas atteindre la boucle locale d'une autre machine.
BIND_ADDRESS=192.168.20.50
BIND_PORT=8787


# --- Général -----------------------------------------------------------------
TZ=America/Toronto
# Le titre n'annonce aucune spécialité : ce qui est propre à une pratique vit
# dans les gabarits et dans la consigne générale du panneau d'administration.
APP_TITLE=ConsultAI

# Langue par DÉFAUT de l'installation : « fr » ou « en ».
#
# Chaque usager choisit ensuite la sienne depuis le menu de la pastille
# d'identité, en haut à droite ; son choix est enregistré en base sous son
# identité et ne touche personne d'autre. Cette variable ne sert qu'à ceux qui
# n'ont jamais choisi.
#
# (La langue n'est PAS dans le panneau d'administration : celui-ci est réservé
# aux administrateurs, et la langue regarde la personne qui lit l'écran.)
#
# Ce n'est PAS qu'un habillage. La langue traverse toute la chaîne :
#   • les textes de l'interface et les messages d'erreur ;
#   • le code de langue envoyé au service de reconnaissance vocale ;
#   • le lexique d'adaptation intégré, qui est francophone et n'est donc PAS
#     envoyé en mode anglais (le vocabulaire du gabarit, lui, part toujours) ;
#   • la langue dans laquelle le modèle rédige la note.
#
# Vos gabarits ne sont jamais réécrits : ils restent dans la langue où vous les
# avez écrits, et leurs titres de rubriques s'imposent au modèle. Un gabarit
# français produira donc des titres français même en mode anglais.
APP_LANGUAGE=fr

LOG_LEVEL=INFO
# Chemin de la base SQLite DANS le conteneur (4 barres obliques = chemin absolu)
DATABASE_URL=sqlite:////data/consultai.db


# --- Authentification OpenID Connect -----------------------------------------
# L'application authentifie ELLE-MÊME. Le reverse proxy n'est plus qu'un relais.
#
# ⚠️ SI VOUS ÊTES DERRIÈRE PANGOLIN : son authentification doit être DÉSACTIVÉE
#    pour cette ressource. Quand Pangolin authentifie, il retire l'en-tête
#    « Cookie » des requêtes qu'il relaie — la session ne peut alors jamais
#    tenir et la connexion boucle indéfiniment.
#
# À créer chez votre fournisseur : un client OIDC « confidentiel », avec pour
# adresse de retour exactement la valeur d'OIDC_REDIRECT_URI ci-dessous.
OIDC_PROVIDER_URL=https://login.exemple.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://consultai.exemple.com/auth/callback
BASE_URL=https://consultai.exemple.com
# « groups » est facultative : sans elle, tout le monde entre dans « users ».
OIDC_SCOPES=openid,profile,email,groups
# Nom de la revendication portant les groupes : « groups » chez Pocket ID et
# Authentik, parfois « roles » chez Keycloak selon la configuration du client.
OIDC_GROUPS_CLAIM=groups

# Nom du fournisseur d'identité tel qu'il apparaît sur les pages d'erreur
# (« ConsultAI — accès contrôlé par … »). Laissé vide, l'application affiche
# l'hôte d'OIDC_PROVIDER_URL, ce qui est moins élégant mais toujours exact.
SSO_DISPLAY_NAME=

# Signature du témoin de session. OBLIGATOIRE en pratique : sans elle, une clé
# aléatoire est tirée à chaque démarrage et tout le monde est déconnecté.
#   openssl rand -base64 48
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=43200
# À ne passer à false que pour un essai local en http://localhost.
SESSION_HTTPS_ONLY=true


# --- Qui a le droit d'entrer --------------------------------------------------
# false = seuls les comptes déjà connus de l'application peuvent entrer ; un
#         inconnu authentifié par le fournisseur est refusé.
# true  = tout compte authentifié est créé automatiquement dans « users ».
#         À ne faire que si l'inscription est FERMÉE chez le fournisseur.
# Modifiable ensuite depuis le panneau d'administration.
ALLOW_SIGNUP=false

# LE PREMIER USAGER QUI SE CONNECTE DEVIENT ADMINISTRATEUR, quel que soit
# ALLOW_SIGNUP. C'est l'amorçage : sans cette exception, une installation neuve
# n'aurait personne pour ouvrir le panneau et serait inutilisable.

# Amorçage facultatif : ces comptes sont créés au premier démarrage pour que
# l'installation ne parte pas vide. Le premier entre dans « admins ». Une fois
# les comptes en base, cette variable ne sert plus à rien.
AUTHORIZED_USERS=dr.tremblay@clinique.qc.ca

# Contournement d'authentification — DÉVELOPPEMENT LOCAL UNIQUEMENT.
# Sert aussi de porte de secours : si plus personne ne peut entrer, passez-la à
# true le temps de réparer les comptes, puis remettez-la à false.
AUTH_DISABLED=false
DEV_USER=dev@local


# --- Google Cloud Speech-to-Text ---------------------------------------------
# Compte de service avec le rôle « Cloud Speech Client ».
# Déposez le JSON dans ./secrets/gcp-sa.json (monté en lecture seule).
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json
# LAISSER VIDE dans le cas normal : le code de langue suit alors APP_LANGUAGE
# (fr → fr-CA, en → en-CA). Une valeur inscrite ici FORCE la langue du service
# vocal et survit au changement de langue de l'application — ce qui n'est
# souhaitable que pour épingler un dialecte précis.
STT_LANGUAGE_CODE=
# latest_long = modèle recommandé pour la dictée continue en français.
# (Le modèle « medical_conversation » de Google est ANGLOPHONE uniquement.)
STT_MODEL=latest_long
STT_USE_ENHANCED=true
# Point de terminaison régional, ex. us-speech.googleapis.com ou
# eu-speech.googleapis.com. Vide = point de terminaison global.
STT_API_ENDPOINT=
# Optionnel : bucket GCS pour les dictées > ~50 min (dépassement de la limite
# de 10 Mo des requêtes gRPC en ligne). L'objet est supprimé après usage.
STT_GCS_BUCKET=
# Taille maximale acceptée pour un téléversement audio (Mo).
MAX_AUDIO_MB=120


# --- Retrait des longues pauses avant envoi -----------------------------------
# Les trois services facturent à la durée d'audio : les pauses d'une
# consultation sont payées plein tarif pour rien. Seule la COPIE ENVOYÉE est
# raccourcie — l'enregistrement conservé avec le brouillon reste intact, et la
# durée affichée reste celle de la dictée réelle. Voir README § 5 bis.
#
# Les deux premiers réglages sont aussi dans le panneau d'administration.
STT_TRIM_SILENCE=true
# Toute pause plus courte est gardée telle quelle ; les plus longues sont
# ramenées à cette durée. NE PAS METTRE 0 : les moteurs se servent des pauses
# pour placer la ponctuation et séparer les phrases.
STT_SILENCE_KEEP_SECONDS=0.5
# Seuil au-dessous duquel l'audio est considéré comme du silence. Plus bas =
# plus prudent (moins de choses retirées). -40 dB convient à un micro avec
# réduction de bruit ; remontez vers -32 si le local est bruyant.
STT_SILENCE_THRESHOLD_DB=-40

# --- Deepgram (service de reconnaissance vocale alternatif) -------------------
# Le choix du service — Google, Deepgram ou AssemblyAI — se fait dans le
# panneau d'administration, qui peut aussi y enregistrer les clés sans passer
# par ce fichier. Les valeurs ci-dessous ne servent que de défaut.
# nova-2 pour le français canadien : c'est la dernière génération où
# l'adaptation par mots-clés fonctionne hors anglais.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2


# --- AssemblyAI (service de reconnaissance vocale alternatif) -----------------
# Le seul des trois à proposer un modèle spécialisé en terminologie clinique
# qui couvre le français (module « medical-v1 », activé par défaut dans le
# panneau). Facturé en supplément — voir README § 5 bis.
# universal-3-5-pro reconnaît explicitement le français québécois et accepte
# 1000 termes d'adaptation ; universal-2 en accepte 200.
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_MODEL=universal-3-5-pro


# --- Soniox (service de reconnaissance vocale alternatif) ---------------------
# Le moins cher des quatre au tarif annoncé (~0,10 $US/h en asynchrone) et le
# seul multilingue par conception : une même requête couvre 60+ langues, ce qui
# convient à une consultation qui alterne français et anglais.
# Le fichier téléversé est supprimé chez Soniox après la transcription.
SONIOX_API_KEY=
SONIOX_MODEL=stt-async-v5


# --- Cohere Transcribe (cinquième service de reconnaissance vocale) -----------
# ⚠️ LIMITE DE DÉBIT : 5 REQUÊTES PAR MINUTE sur une clé d'essai, toutes dictées
#    confondues. La dictée envoie une tranche toutes les ~30 s ET PAR USAGER :
#      • une dictée en cours  → ~2 req/min, ça passe ;
#      • deux                 → ~4 req/min, ça passe à peine ;
#      • trois et plus        → la limite est dépassée.
#    À ne pas retenir pour un usage simultané. Une clé de production se négocie
#    avec Cohere. L'application étale les envois et réessaie sur 429, mais une
#    tranche peut être retardée — voir stt._transcribe_cohere.
#
# ⚠️ AUCUNE ADAPTATION AU VOCABULAIRE : ni mots-clés, ni contexte. Le lexique
#    clinique et le vocabulaire des gabarits ne lui sont pas transmis.
#
# Modèle dédié de reconnaissance vocale, 14 langues dont le français.
# L'API n'accepte que de l'ISO-639-1 (« fr », « en »), jamais « fr-CA ».
COHERE_API_KEY=
COHERE_MODEL=cohere-transcribe-03-2026


# --- Enregistrements conservés avec les brouillons ----------------------------
# L'audio d'une consultation reste attaché à son brouillon et s'efface avec
# lui. À laisser sous /data. Voir README § 9 : c'est de la voix de patient.
AUDIO_DIR=/data/audio


# --- Dictée par segments ------------------------------------------------------
# La dictée est téléversée pendant qu'elle se fait, puis transcrite par
# tranches. Voir README § 5 « La dictée ».
#
# Où le serveur accumule l'audio en cours. À laisser sous /data : le volume
# monté survit au conteneur, donc une dictée en cours survit à un redémarrage.
DICTATION_DIR=/data/dictations
# Cadence de téléversement, en secondes. C'est le pire cas de perte sur une
# panne franche du navigateur. Descendre en dessous de 3 multiplie les
# requêtes sans gagner grand-chose.
DICTATION_CHUNK_SECONDS=5
# Durée visée d'une tranche transcrite. Elle fixe le délai d'affichage du
# texte. Au-delà de 55 s, Google refuse la reconnaissance synchrone et le
# retour devient bien plus lent : ne pas dépasser 45.
DICTATION_SEGMENT_SECONDS=30
# Durée de conservation d'une dictée jamais conclue (heures). La purge a lieu
# au démarrage. Une dictée conclue, elle, est effacée immédiatement.
DICTATION_RETENTION_HOURS=72


# --- Gemini -------------------------------------------------------------------
# MODE 1 — Clé API Google AI Studio (le plus simple) :
GEMINI_API_KEY=
#
# MODE 2 — Vertex AI (RECOMMANDÉ POUR DES DONNÉES DE SANTÉ QUÉBÉCOISES : les
# requêtes restent dans la région choisie, Montréal). Laissez GEMINI_API_KEY
# VIDE et renseignez ci-dessous ; l'authentification réutilise le compte de
# service GOOGLE_APPLICATION_CREDENTIALS (rôle « Vertex AI User » requis).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=northamerica-northeast1

# Modèle par défaut. NOTE : le cahier des charges mentionnait
# « gemini-3.5-flash » ; ce nom n'existe pas dans le catalogue Google.
# Vérifiez les modèles réellement accessibles avec votre clé via GET /api/models
# (l'application journalise aussi un avertissement au démarrage si le modèle
# configuré est introuvable). Changez simplement la valeur ici le cas échéant.
GEMINI_MODEL=gemini-2.5-flash
# Modèle « haut de gamme », activé par la bascule ci-dessous ou par requête.
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_USE_PRO=false
# Température basse = fidélité maximale à la dictée, peu de reformulation.
GEMINI_TEMPERATURE=0.15
GEMINI_MAX_OUTPUT_TOKENS=8192


# --- Autres fournisseurs de modèle de langage ---------------------------------
# Le fournisseur et le modèle se choisissent dans le panneau d'administration,
# qui peut aussi y enregistrer les clés sans passer par ce fichier.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
